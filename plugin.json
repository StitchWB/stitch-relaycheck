  "status": "beta",
  "icon": "🧪",
  "features": [
    {
      "title": {
        "ru": "Быстрый чек endpoint: подключение, протокол, список моделей, латентность",
        "en": "Quick endpoint check: connectivity, protocol, model list, latency"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Сохраняемые цели (relay) с шифрованием API-ключей",
        "en": "Saved targets (relays) with encrypted API keys"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "История проверок и markdown-отчёты локально",
        "en": "Local check history and markdown reports"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Fingerprint оригинальности модели (tokenizer deltas, capability, consistency)",
        "en": "Model authenticity fingerprint (tokenizer deltas, capability, consistency)"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Детект «водности» ответов (watering), опционально со сравнением с reference",
        "en": "Answer watering detection, optionally compared against a reference endpoint"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Запрос баланса/квоты панели (one-api/new-api, LiteLLM), read-only",
        "en": "Read-only balance/quota lookup (one-api/new-api, LiteLLM)"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Security-скан: canary-пробы, инъекции tool_use, правила HoloNe, IOC/TLS",
        "en": "Security scan: canary probes, tool_use injection, HoloNe rules, IOC/TLS"
      },
      "status": "beta"
    }
  ],
  "changelog": [
    {
      "version": "0.4.0",
      "date": "2026-10-09",
      "changes": [
        {
          "ru": "Security-скан (scan_security): canary-пробы, детект неспрашиваемого tool_use, инъекционные пробы, вендowany движок правил HoloNe (105 правил v4 + blocklist), IOC и TLS-проверки, risk score; скрипт синка правил scripts/sync_holone_rules.py",
          "en": "Security scan (scan_security): canary probes, unsolicited tool_use detection, injection probes, vendored HoloNe rules engine (105 rules v4 + blocklist), IOC and TLS checks, risk score; rules sync script scripts/sync_holone_rules.py"
        }
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-10-09",
      "changes": [
        {
          "ru": "Watering-detector (detect_watering): эвристики + сравнение с reference; парсер баланса (get_balance) для one-api/new-api/LiteLLM; UI-кнопки «Вода» и «Баланс» у целей",
          "en": "Watering detector (detect_watering): heuristics + reference comparison; balance parser (get_balance) for one-api/new-api/LiteLLM; 'Water' and 'Balance' row actions in UI"
        }
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-09",
      "changes": [
        {
          "ru": "Fingerprint: команда verify_model (tokenizer deltas, capability-пробы, split-half consistency, stream shape, metadata), база профилей моделей, вердикты authentic/likely_authentic/indeterminate/suspicious/substituted",
          "en": "Fingerprint: verify_model command (tokenizer deltas, capability probes, split-half consistency, stream shape, metadata), model profile DB, verdicts authentic/likely_authentic/indeterminate/suspicious/substituted"
        }
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-10-09",
      "changes": [
        {
          "ru": "Первый релиз: быстрый чек endpoint, цели с Fernet-шифрованием ключей, история, настройки",
          "en": "Initial release: quick endpoint check, targets with Fernet-encrypted keys, history, settings"
        }
      ]
    }
  ],
